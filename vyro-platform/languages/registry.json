[
  {
    "id": "gdscript",
    "name": "GDScript",
    "extensions": [
      ".gd"
    ],
    "lsp": "Godot built-in language server",
    "keywords": [
      "extends",
      "class_name",
      "func",
      "signal",
      "var",
      "const",
      "@export",
      "@onready",
      "await",
      "return",
      "if",
      "else",
      "elif",
      "for",
      "while",
      "match",
      "static",
      "super",
      "self",
      "preload",
      "load"
    ]
  },
  {
    "id": "csharp",
    "name": "C#",
    "extensions": [
      ".cs"
    ],
    "lsp": "Roslyn language server",
    "keywords": [
      "using",
      "namespace",
      "class",
      "public",
      "private",
      "protected",
      "internal",
      "void",
      "async",
      "await",
      "override",
